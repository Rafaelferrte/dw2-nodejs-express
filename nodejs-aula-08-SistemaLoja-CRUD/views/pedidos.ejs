<%- include ('partials/header.ejs') %>
<%- include ('partials/navbar.ejs') %>

    <!-- Formulario de pedidos -->
     <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Cadastrar pedidos</h1>
            </div>
            <div class="card-body">
                <form action="/pedidos/cadastrar/" method="POST">
                    <label for="numero">Numero do pedido:</label>
                    <input type="number" name="numero" id="numero" placeholder="Insira o número" class="form-control" required>
                    <label for="valor">Valor do produto</label>
                    <input type="number" name="valor" id="numero" min="0" step="0.01" placeholder="Insira o valor" class="form-control" required>
                    <br>
                    <button type="submit" class="btn btn-success">Cadastrar</button>
                    <button type="reset" class="btn btn-danger">Limpar</button>
                </form>
            </div>
        </div>
        <br>
     </div>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <h1>Pedidos</h1>
            </div>
            <div class="card-body">
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Número:</th>
                            <th>Valor:</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% pedidos.forEach(pedido => { %>
                        <tr>
                            <td><img src="imgs/order.png" width="30px"></td>
                            <td><%= pedido.numero %></td>
                            <td><%= pedido.valor.toLocaleString('pt-br', {style: 'currency', currency: 'BRL'}) %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<%- include ('partials/footer.ejs') %>
